# InvokeAI MCP configuration
# Copy to .env and adjust. The backend serves on INVOKEAI_MCP_PORT (11154)
# and the Vite webapp on the adjacent frontend port (11155).

# InvokeAI instance (default http://127.0.0.1:9090 - InvokeAI launcher default)
INVOKEAI_URL=http://127.0.0.1:9090

# Queue id InvokeAI uses (default "default")
INVOKEAI_QUEUE_ID=default

# Where generated images are saved when tools ask for a local file
# (invokeai_queue result download_image=true)
INVOKEAI_DOWNLOAD_DIR=D:/Dev/repos/invokeai-mcp/data/downloads

# Backend webapp port (fleet registry: 11154)
INVOKEAI_MCP_PORT=11154

# Frontend Vite dev port (fleet registry: 11155)
INVOKEAI_FRONTEND_PORT=11155

# Optional: Civitai/HF token for private model downloads (passed through to InvokeAI)
# INVOKEAI_ACCESS_TOKEN=
